print('задание 3')

message = "1010"
def encode(data):
    d1, d2, d3, d4 = (int(x) for x in data)
    p1 = d1 ^ d2 ^ d4
    p2 = d1 ^ d3 ^ d4
    p4 = d2 ^ d3 ^ d4
    code = [p1, p2, d1, p4, d2, d3, d4]
    return ''.join(str(x) for x in code)
code = encode(message)
def syndrome(code):
    b = [int(x) for x in code]
    s1 = b[0] ^ b[2] ^ b[4] ^ b[6]
    s2 = b[1] ^ b[2] ^ b[5] ^ b[6]
    s4 = b[3] ^ b[4] ^ b[5] ^ b[6]
    return s1 * 1 + s2 * 2 + s4 * 4
sn = syndrome(code)
print(code)
print(sn)



